{
  "name": "staffsync",
  "version": "1.0.0",
  "description": "StaffSync — Full-Stack MERN HR Management System",
  "scripts": {
    "server:install": "npm --prefix server install",
    "client:install": "npm --prefix client install",
    "install:all": "npm run server:install && npm run client:install",
    "seed": "npm --prefix server run seed",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test": "npm run test:server && npm run test:client",
    "build:client": "npm --prefix client run build"
  },
  "keywords": [
    "mern",
    "hr-management",
    "staffsync",
    "attendance",
    "leave-management",
    "react",
    "express",
    "mongodb"
  ],
  "author": "StaffSync Engineering Team",
  "license": "ISC"
}
